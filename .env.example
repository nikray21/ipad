# Where finished episodes go. deckpath.py also FINDS them one level deeper,
# so filing a deck into a subfolder never breaks its audit trail.
export DECK_OUT="$HOME/Desktop/Stock Analys"

# Required by liquidity_swings.py / trade_setup.py (alpaca_data.py) — the TA
# tools' only bar source, by hard rule: no Yahoo, no Nasdaq, no Webull charts.
# Free key at https://alpaca.markets. Never commit real values here.
export APCA_API_KEY_ID="..."
export APCA_API_SECRET_KEY="..."
